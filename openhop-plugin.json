{
  "schema": 1,
  "id": "openhop.mcp",
  "name": "openHop MCP Server",
  "version": "0.5.3",
  "description": "Model Context Protocol server exposing openHop Repeater telemetry over authenticated, IP-whitelisted HTTP.",
  "runtime": {
    "type": "python",
    "entrypoint": "openhop-mcp"
  },
  "config": {
    "defaults": {
      "host": "127.0.0.1",
      "port": 8765,
      "openhop_base_url": "http://127.0.0.1:8000",
      "openhop_api_key": "",
      "auth_tokens": [],
      "allowed_ips": ["127.0.0.1/32", "::1/128"],
      "read_only": true,
      "request_timeout_seconds": 15,
      "max_items": 200,
      "allow_insecure_bind": false,
      "max_auth_failures": 10,
      "auth_failure_window_seconds": 300,
      "auth_lockout_seconds": 900,
      "repeater_db_path": "/var/lib/openhop_repeater/repeater.db",
      "allow_message_history": true
    }
  }
}
